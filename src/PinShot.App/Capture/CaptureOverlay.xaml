<Window x:Class="PinShot.App.Capture.CaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Cursor="Arrow"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Focusable="True">
    <!-- 根容器必须有�?null 背景：AllowsTransparency 窗口的命中测试依赖绘制内容，
         否则编辑阶段某些区域点击会穿透到下层窗口 -->
    <Grid Background="#01FFFFFF">
        <Image x:Name="BgImage" Stretch="Fill" />

        <Canvas x:Name="MaskCanvas" IsHitTestVisible="False">
            <Rectangle x:Name="MaskTop" Fill="#59000000" />
            <Rectangle x:Name="MaskBottom" Fill="#59000000" />
            <Rectangle x:Name="MaskLeft" Fill="#59000000" />
            <Rectangle x:Name="MaskRight" Fill="#59000000" />
            <Rectangle x:Name="HoverRect" Stroke="#FF2D8CFF" StrokeThickness="2"
                       Visibility="Collapsed" />
            <Rectangle x:Name="SelRect" Stroke="#FFFFFFFF" StrokeThickness="1"
                       Visibility="Collapsed" />
            <Rectangle x:Name="SelRectInner" Stroke="#FF2D8CFF" StrokeThickness="1"
                       Visibility="Collapsed" />
            <Line x:Name="CrossHorizontal" Stroke="#A6FFFFFF" StrokeThickness="1"
                  Visibility="Collapsed" />
            <Line x:Name="CrossVertical" Stroke="#A6FFFFFF" StrokeThickness="1"
                  Visibility="Collapsed" />
        </Canvas>

        <Canvas x:Name="EditorCanvas" />

        <Canvas x:Name="HandleCanvas" />

        <Border x:Name="Magnifier" Background="#E6000000" BorderBrush="#FF2D8CFF"
                BorderThickness="1" CornerRadius="4" Visibility="Collapsed"
                IsHitTestVisible="False" Padding="4">
            <StackPanel>
                <Image x:Name="MagnifierImage" Width="126" Height="126" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock x:Name="MagnifierText" Foreground="#FFF0F0F0" FontFamily="Consolas"
                           FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <Border x:Name="InfoBar" Style="{StaticResource HintBorder}" CornerRadius="8" Padding="10,5"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Visibility="Collapsed" Cursor="Hand" MouseLeftButtonDown="OnInfoBarClicked">
            <TextBlock x:Name="InfoText" Foreground="#FFF0F0F0" FontFamily="Consolas"
                       FontSize="12" />
        </Border>

        <!-- 自绘鼠标指针：放在最上层，不依赖系统光标是否显示 -->
        <Canvas x:Name="PointerCanvas" IsHitTestVisible="False">
            <Path x:Name="PointerArrow" Fill="#FFFFFFFF" Stroke="#FF000000" StrokeThickness="1.2"
                  StrokeLineJoin="Round">
                <Path.Data>
                    <PathGeometry Figures="M0,0 L0,17 L4.2,13 L6.8,19 L9.6,17.7 L7,11.8 L12.5,11.8 Z" />
                </Path.Data>
            </Path>
        </Canvas>

        <!-- 截图选项条：圆角、阴影、光标、比�?-->
        <StackPanel x:Name="OptionsBar" Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                    Visibility="Collapsed">
            <StackPanel.Resources>
                <Style TargetType="Button">
                    <Setter Property="Foreground" Value="#FFEDEDED" />
                    <Setter Property="Background" Value="#CC1C1C1F" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EE2D8CFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <Button x:Name="CornerButton" Click="OnCornerClicked" ToolTip="圆角截图（Ctrl+R 循环半径�? />
            <Button x:Name="ShadowButton" Click="OnShadowClicked" ToolTip="输出加阴�?边框" />
            <Button x:Name="CursorButton" Click="OnCursorClicked" ToolTip="截图包含鼠标指针（~�? />
        </StackPanel>

        <Border x:Name="TipBar" Style="{StaticResource HintBorder}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28">
            <TextBlock x:Name="TipText" Foreground="#FFDADADA" FontSize="12"
                       Text="拖动选择 · 回车复制 · Ctrl+S 保存 · P 贴图 · R 历史选区 · C 取色 · ~ 光标 · Esc 退�? />
        </Border>
    </Grid>
</Window>
