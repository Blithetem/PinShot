<Window x:Class="PinShot.App.Capture.SizeInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="OnDragMove">
    <Border Background="#F21C1C1F" CornerRadius="10" Padding="18,14">
        <StackPanel>
            <TextBlock Text="手动输入截图宽高" Foreground="#FFEDEDED" FontSize="13"
                       FontWeight="SemiBold" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="宽" Foreground="#FFB8B8B8" VerticalAlignment="Center" />
                <TextBox x:Name="WidthBox" Width="88" Margin="8,0,16,0" Padding="6,4"
                         Background="#33FFFFFF" Foreground="#FFFFFFFF" BorderThickness="0"
                         FontFamily="Consolas" VerticalContentAlignment="Center" />
                <TextBlock Text="高" Foreground="#FFB8B8B8" VerticalAlignment="Center" />
                <TextBox x:Name="HeightBox" Width="88" Margin="8,0,0,0" Padding="6,4"
                         Background="#33FFFFFF" Foreground="#FFFFFFFF" BorderThickness="0"
                         FontFamily="Consolas" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Width="64" Style="{StaticResource ToolbarActionButton}"
                        Click="OnCancel" />
                <Button Content="确定" Width="64" Margin="8,0,0,0"
                        Style="{StaticResource ToolbarPrimaryButton}" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
