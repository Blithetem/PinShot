<Window x:Class="PinShot.App.LongShot.LongShotBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False">
    <Border Background="{StaticResource ToolbarBackgroundBrush}" CornerRadius="10" Padding="14,9">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.5" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="9" Height="9" Fill="#FFFF3B30" Margin="0,0,8,0"
                     VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="在选区内滚动页面收集内容" Foreground="#FFEDEDED"
                       FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button x:Name="DoneButton" Content="完成" Width="64" Height="28" FontSize="13"
                    Style="{StaticResource ToolbarPrimaryButton}" />
            <Button x:Name="CancelButton" Content="取消" Width="64" Height="28" FontSize="13"
                    Margin="8,0,0,0" Style="{StaticResource ToolbarActionButton}" />
        </StackPanel>
    </Border>
</Window>