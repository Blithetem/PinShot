<Window x:Class="PinShot.App.Recorder.RecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        ShowActivated="False" UseLayoutRounding="True">
    <Border Background="#F21C1C1F" CornerRadius="12" Padding="14,8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.5" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FFE83A3A" VerticalAlignment="Center" />
            <TextBlock x:Name="TimeText" Text="00:00" Foreground="White" FontFamily="Consolas"
                       FontSize="14" Margin="10,0" VerticalAlignment="Center" />
            <Border Width="1" Height="16" Background="#33FFFFFF" Margin="6,0"
                    VerticalAlignment="Center" />
            <Button x:Name="StopButton" Content="停止" Width="48" Height="26" FontSize="12"
                    Style="{StaticResource ToolbarButton}" />
        </StackPanel>
    </Border>
</Window>
