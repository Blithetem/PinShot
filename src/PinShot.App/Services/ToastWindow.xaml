<Window x:Class="PinShot.App.Services.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        ShowActivated="False" IsHitTestVisible="False" Focusable="False">
    <Border Background="#F21F1F22" CornerRadius="12" Padding="18,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.5" />
        </Border.Effect>
        <StackPanel MaxWidth="360">
            <TextBlock x:Name="TitleText" Foreground="#FFF2F2F2" FontSize="14"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="BodyText" Foreground="#FFBDBDBD" FontSize="12"
                       Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
