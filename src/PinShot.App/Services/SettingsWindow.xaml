<Window x:Class="PinShot.App.Services.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinShot 设置" Width="600" Height="700"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F21C1C1F" Foreground="#FFEDEDED"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8FB8FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB8B8B8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="96" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFEDEDED" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,16,18,14" Background="#F21C1C1F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="560">
            <StackPanel>
                <!-- 热键 -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="全局热键" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="点输入框后直接按下想要的组合键；离焦或按 Esc 取消输入。"
                                   Foreground="#FF9A9A9A" FontSize="11" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="截图" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="CaptureHotkeyBox" Grid.Column="1" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False" Cursor="Hand"
                                     PreviewKeyDown="OnHotkeyKeyDown" GotFocus="OnHotkeyFocus" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="贴图" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="PinHotkeyBox" Grid.Column="1" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False" Cursor="Hand"
                                     PreviewKeyDown="OnHotkeyKeyDown" GotFocus="OnHotkeyFocus" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="恢复贴图" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="RestoreHotkeyBox" Grid.Column="1" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False" Cursor="Hand"
                                     PreviewKeyDown="OnHotkeyKeyDown" GotFocus="OnHotkeyFocus" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="录屏" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="RecordHotkeyBox" Grid.Column="1" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False" Cursor="Hand"
                                     PreviewKeyDown="OnHotkeyKeyDown" GotFocus="OnHotkeyFocus" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 保存 -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="保存" Style="{StaticResource SectionTitle}" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认目录" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="DirectoryBox" Grid.Column="1" />
                            <Button Grid.Column="2" Content="浏览" Width="56" Margin="8,0,0,0"
                                    Style="{StaticResource ToolbarActionButton}" Click="OnBrowse" />
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认格式" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="FormatBox" Grid.Column="1" SelectionChanged="OnFormatChanged">
                                <ComboBoxItem Content="PNG（无损）" Tag="png" />
                                <ComboBoxItem Content="JPG（体积小）" Tag="jpg" />
                                <ComboBoxItem Content="BMP（无压缩）" Tag="bmp" />
                            </ComboBox>
                        </Grid>

                        <Grid x:Name="QualityRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="JPG 质量" Style="{StaticResource FieldLabel}" />
                            <Slider x:Name="QualitySlider" Grid.Column="1" Minimum="10" Maximum="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" />
                            <TextBlock x:Name="QualityText" Grid.Column="2" Width="34"
                                       TextAlignment="Right" Foreground="#FFB8B8B8" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 截图行为 -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="截图" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="CursorCheck" Content="截图默认包含鼠标指针" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="默认圆角" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CornerBox" Grid.Column="1">
                                <ComboBoxItem Content="关闭" Tag="0" />
                                <ComboBoxItem Content="8 px" Tag="8" />
                                <ComboBoxItem Content="16 px" Tag="16" />
                                <ComboBoxItem Content="24 px" Tag="24" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 录制 -->
                <Border Style="{StaticResource SectionBorder}">
                    <StackPanel>
                        <TextBlock Text="录制" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="Mp4Check" Content="录制后转成 MP4（体积约为 AVI 的 1/10）"
                                  Margin="0,0,0,4" />
                        <TextBlock Text="需要 ffmpeg；找不到时保持 AVI。" FontSize="11"
                                   Foreground="#FF8A8A92" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ffmpeg 路径" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="FfmpegBox" Grid.Column="1" />
                            <Button Grid.Column="2" Content="浏览" Width="56" Margin="8,0,0,0"
                                    Style="{StaticResource ToolbarActionButton}" Click="OnBrowseFfmpeg" />
                        </Grid>
                        <TextBlock x:Name="FfmpegStatusText" FontSize="11" Foreground="#FF8A8A92"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="#FFFFB74D" FontSize="11"
                   TextWrapping="Wrap" Margin="2,0,2,8" Visibility="Collapsed" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="恢复默认" Width="86" Style="{StaticResource ToolbarActionButton}"
                    Click="OnResetDefaults" Margin="0,0,8,0" />
            <Button Content="取消" Width="72" Style="{StaticResource ToolbarActionButton}"
                    Click="OnCancel" />
            <Button Content="保存" Width="72" Margin="8,0,0,0"
                    Style="{StaticResource ToolbarPrimaryButton}" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
