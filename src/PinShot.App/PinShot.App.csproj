<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 不指定 Windows SDK 版本：避免引入 23.5 MB 的 WinRT 投影。
         需要 WinRT 的 OCR 能力做成可选插件，见 src\PinShot.Ocr.WinRt。 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PinShot</AssemblyName>
    <RootNamespace>PinShot.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>0.1.0</Version>
    <!-- 自定义入口：先走不依赖 WPF 的 CLI 快速路径（App.xaml 因此改为 Page） -->
    <StartupObject>PinShot.App.Program</StartupObject>
    <!-- WPF 需要 manifest 中的 PerMonitorV2 设置；WinForms 分析器建议改用项目属性，此处保留 manifest -->
    <NoWarn>$(NoWarn);WFAC010;NU1903;NU1902</NoWarn>
  </PropertyGroup>

  <!--
    App.xaml 默认作为 ApplicationDefinition 会由 XAML 编译器生成 Main，
    与自定义 Program.Main 冲突，所以改成普通 Page（只生成 InitializeComponent）。
  -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!--
    同时启用 WPF 与 WinForms 时，SDK 会为 WinForms 注入 System.Windows.Forms / System.Drawing
    的隐式 using，导致 Application、Point、MouseEventArgs 等与 WPF 同名类型冲突。
    这里移除这两个隐式 using，需要时在文件内显式引入。
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpAvi" Version="3.0.1" />
  </ItemGroup>

  <!-- OCR 插件契约（极小）；WinRT 实现在可选插件项目里，主程序不引用 -->
  <ItemGroup>
    <ProjectReference Include="..\PinShot.Ocr.Abstractions\PinShot.Ocr.Abstractions.csproj" />
  </ItemGroup>

</Project>
